{
  "id": "blog-first",
  "name": "Blog First",
  "nameZh": "博客优先",
  "version": "1.0.0",
  "contractVersion": "1",
  "author": "Inkless CMS",
  "description": "Minimal personal blog with author intro and article list at home",
  "descriptionZh": "极简个人博客，首页展示作者介绍与最近文章",
  "tags": ["blog", "minimal"],
  "umd": "dist/theme.umd.js",
  "esm": "dist/theme.es.js",
  "entry": {
    "builtin": "src/index.ts",
    "register": "src/register.ts"
  },
  "peerHost": {
    "sharedGlobal": "__INKLESS_SHARED__",
    "hostGlobal": "InklessThemeHost",
    "registerGlobal": "__INKLESS_THEME_REGISTER__"
  },
  "contentSlots": [
    {
      "pageKey": "home",
      "schemaId": "blog-first/home@1",
      "title": { "zh": "博客首页", "en": "Blog home" },
      "description": "Optional home overrides; author identity lives in site config; posts from articles API",
      "schema": "schemas/content/home.schema.json",
      "mediaRefPaths": ["cover", "hero.media"],
      "localizedPaths": [
        "title",
        "intro",
        "recentHeading",
        "hero.title",
        "hero.subtitle"
      ],
      "stringPaths": ["moreHref", "moreLabel"]
    }
  ]
}
